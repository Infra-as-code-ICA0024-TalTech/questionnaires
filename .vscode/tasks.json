{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Questions: Create Python environment",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "venv",
        ".venv"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "-m",
          "venv",
          ".venv"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Questions: Set up dependencies",
      "detail": "Run once after cloning, or after requirements.txt changes. Requires Python 3.12+ and internet access.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Questions: Create Python environment",
      "problemMatcher": []
    },
    {
      "label": "Questions: Convert all formats",
      "detail": "Build and validate Moodle XML, Forms PDFs, and the grading reference from Markdown.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "scripts/build.py",
        "--format",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Questions: Convert to Moodle XML",
      "detail": "Build and validate only the three Moodle XML files.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "scripts/build.py",
        "--format",
        "moodle"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Questions: Convert to Microsoft Forms PDF",
      "detail": "Build and validate only the three Forms import PDFs and regenerate the grading reference.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "scripts/build.py",
        "--format",
        "forms"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Questions: Validate exports",
      "detail": "Check all existing question exports without rebuilding them.",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "scripts/build.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
